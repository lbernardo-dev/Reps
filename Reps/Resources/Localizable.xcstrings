    "rehab_sit_on_the_floor_with_both_knees_bent_to_90_one_leg_in_front_and_one_out" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit on the floor with both knees bent to 90°, one leg in front and one out to the side."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate en el suelo con ambas rodillas dobladas a 90°, una pierna delante y la otra hacia el lado."
          }
        }
      }
    },
    "rehab_sit_or_lie_with_the_leg_straight_a_small_rolled_towel_under_the_knee" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit or lie with the leg straight, a small rolled towel under the knee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o túmbate con la pierna estirada, con una toalla enrollada bajo la rodilla."
          }
        }
      }
    },
    "rehab_sit_or_stand_tall_looking_straight_ahead" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit or stand tall, looking straight ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate o ponte de pie erguido, mirando al frente."
          }
        }
      }
    },
    "rehab_sit_with_the_leg_extended_and_the_ankle_relaxed_off_a_support" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit with the leg extended and the ankle relaxed off a support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate con la pierna extendida y el tobillo relajado fuera de un apoyo."
          }
        }
      }
    },
    "rehab_slowly_circle_the_wrist_10_times_in_each_direction" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly circle the wrist 10 times in each direction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circunda la muñeca lentamente 10 veces en cada dirección."
          }
        }
      }
    },
    "rehab_slowly_extend_one_arm_forward_and_the_opposite_leg_back_keeping_your_hip" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly extend one arm forward and the opposite leg back, keeping your hips level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extiende lentamente un brazo hacia adelante y la pierna opuesta hacia atrás, manteniendo las caderas niveladas."
          }
        }
      }
    },
    "rehab_slowly_lower_one_arm_overhead_and_the_opposite_leg_toward_the_floor" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly lower one arm overhead and the opposite leg toward the floor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja lentamente un brazo por encima de la cabeza y la pierna opuesta hacia el suelo."
          }
        }
      }
    },
    "rehab_slowly_round_your_back_toward_the_ceiling_tucking_chin_and_pelvis" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly round your back toward the ceiling, tucking chin and pelvis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redondea lentamente la espalda hacia el techo, metiendo la barbilla y la pelvis."
          }
        }
      }
    },
    "rehab_slowly_slide_your_heel_toward_your_glutes_bending_the_knee_as_far_as_com" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly slide your heel toward your glutes, bending the knee as far as comfortable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza lentamente el talón hacia los glúteos, doblando la rodilla hasta donde sea cómodo."
          }
        }
      }
    },
    "rehab_squeeze_your_glutes_and_lift_your_hips_to_a_comfortable_mid_range_height" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squeeze your glutes and lift your hips to a comfortable mid-range height."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprieta los glúteos y eleva la cadera hasta una altura media cómoda."
          }
        }
      }
    },
    "rehab_stand_facing_away_from_the_anchor_with_feet_hip_width_apart_leaning_back" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand facing away from the anchor with feet hip-width apart, leaning back slightly into the band."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie de espaldas al anclaje, con los pies separados al ancho de la cadera, apoyándote ligeramente hacia atrás en la banda."
          }
        }
      }
    },
    "rehab_stand_holding_onto_a_support_feet_flat" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
