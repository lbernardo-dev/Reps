          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada el peso a la pierna afectada y baja el talón lentamente por debajo del nivel del escalón durante unos 3 segundos."
          }
        }
      }
    },
