          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejercicio estándar de movilidad temprana de rodilla tras lesión o cirugía para recuperar el rango de flexión."
          }
        }
      }
    },
    "rehab_start_on_hands_and_knees_spine_neutral" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on hands and knees, spine neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comienza a cuatro patas, con la columna neutra."
          }
        }
      }
    },
    "rehab_start_on_hands_and_knees_spine_neutral_core_gently_braced" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on hands and knees, spine neutral, core gently braced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comienza a cuatro patas, columna neutra, core ligeramente activado."
          }
        }
      }
    },
    "rehab_stop_if_pain_radiates_down_a_leg_or_arm_that_needs_a_professional_assess" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if pain radiates down a leg or arm — that needs a professional assessment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detente si el dolor irradia hacia una pierna o brazo — eso requiere una valoración profesional."
          }
        }
      }
    },
    "rehab_stop_if_the_knee_swells_or_feels_warmer_than_usual_after_sessions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if the knee swells or feels warmer than usual after sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detente si la rodilla se hincha o se siente más caliente de lo habitual después de las sesiones."
          }
        }
      }
    },
    "rehab_stop_if_you_feel_catching_locking_or_sharp_pain_in_a_specific_finger_or" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if you feel catching, locking, or sharp pain in a specific finger or the wrist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detente si sientes bloqueo, enganche o dolor agudo en un dedo concreto o en la muñeca."
          }
        }
      }
    },
    "rehab_stop_if_you_feel_dizziness_tingling_in_the_arms_or_a_sharp_increase_in_h" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if you feel dizziness, tingling in the arms, or a sharp increase in headache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detente si sientes mareo, hormigueo en los brazos o un aumento agudo del dolor de cabeza."
          }
        }
      }
    },
    "rehab_stop_if_you_feel_numbness_tingling_or_sharp_pain_down_the_arm" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop if you feel numbness, tingling, or sharp pain down the arm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detente si sientes entumecimiento, hormigueo o dolor agudo que baja por el brazo."
          }
        }
      }
    },
    "rehab_stop_rolling_the_hips_backward_if_you_notice_it_creeping_in_that_usually" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop rolling the hips backward if you notice it creeping in — that usually means fatigue has set in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de rotar la cadera hacia atrás si notas que empieza a aparecer — suele indicar fatiga."
          }
        }
      }
    },
    "rehab_stretch" : {
      "extractionState" : "stale",
