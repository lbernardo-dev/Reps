    "rehab_tendon_gliding_sequences_are_a_standard_early_mobility_technique_in_hand" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendon gliding sequences are a standard early mobility technique in hand/wrist rehabilitation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las secuencias de deslizamiento tendinoso son una técnica estándar de movilidad temprana en la rehabilitación de mano/muñeca."
          }
        }
      }
    },
    "rehab_then_open_the_hand_fully_straighten_fingers_and_slide_through_a_hook_ful" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then open the hand fully, straighten fingers, and slide through a hook, full, and straight-fist position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego abre la mano por completo, estira los dedos y desliza por una posición en gancho, puño completo y puño recto."
          }
        }
      }
    },
    "rehab_then_slowly_arch_the_other_way_lifting_chest_and_tailbone" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then slowly arch the other way, lifting chest and tailbone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego arquea lentamente hacia el otro lado, levantando el pecho y el coxis."
          }
        }
      }
    },
    "rehab_this_is_mobility_work_not_a_strength_challenge_keep_it_under_3_10_and_ne" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is mobility work, not a strength challenge — keep it under 3/10 and never force the range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es trabajo de movilidad, no un reto de fuerza — mantente por debajo de 3/10 y nunca fuerces el rango."
          }
        }
      }
    },
    "rehab_this_section_is_educational_and_does_not_replace_an_in_person_evaluation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This section is educational and does not replace an in-person evaluation by a physical therapist or physician. Stop and seek professional care if you have sharp, worsening, or persistent pain, swelling, numbness, or a recent acute injury."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sección es educativa y no sustituye la valoración presencial de un fisioterapeuta o médico. Detente y busca atención profesional si tienes dolor agudo, que empeora o persiste, hinchazón, entumecimiento, o una lesión aguda reciente."
          }
        }
      }
    },
    "rehab_this_should_feel_like_controlled_core_effort_if_your_lower_back_arches_o" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This should feel like controlled core effort; if your lower back arches or pain rises above 3/10, reduce the range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe sentirse como un esfuerzo controlado del core; si la zona lumbar se arquea o el dolor sube de 3/10, reduce el rango."
          }
        }
      }
    },
    "rehab_this_should_feel_like_easy_motion_keep_any_discomfort_under_3_10_and_avo" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This should feel like easy motion; keep any discomfort under 3/10 and avoid pushing into a sharp or radiating pain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe sentirse como un movimiento sencillo; mantén cualquier molestia por debajo de 3/10 y evita forzar hacia un dolor agudo o irradiado."
          }
        }
      }
    },
    "rehab_this_should_feel_like_effort_not_pain_keep_discomfort_under_3_10" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This should feel like effort, not pain — keep discomfort under 3/10."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto debe sentirse como esfuerzo, no como dolor — mantén la molestia por debajo de 3/10."
          }
        }
      }
    },
    "rehab_this_should_feel_like_gentle_motion_not_stretching_into_pain_keep_it_und" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This should feel like gentle motion, not stretching into pain — keep it under 3/10 discomfort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe sentirse como un movimiento suave, no un estiramiento doloroso — mantén la molestia por debajo de 3/10."
          }
        }
      }
    },
    "rehab_this_should_feel_like_muscular_effort_in_the_side_of_the_hip_not_joint_p" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This should feel like muscular effort in the side of the hip, not joint pain — keep under 3/10."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe sentirse como esfuerzo muscular en el lateral de la cadera, no dolor articular — mantente por debajo de 3/10."
          }
        }
      }
    },
    "rehab_tuck_your_elbow_against_your_side_bent_to_90_holding_the_band_across_you" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuck your elbow against your side, bent to 90°, holding the band across your body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el codo al costado, doblado a 90°, sujetando la banda cruzada frente al cuerpo."
          }
        }
      }
    },
    "rehab_up_to_4_10_in_the_buttock_tendon_area_is_generally_acceptable_front_of_h" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to ~4/10 in the buttock/tendon area is generally acceptable; front-of-hip pinching pain means the range is too deep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta ~4/10 en la zona glútea/tendinosa suele ser aceptable; un pellizco doloroso en la parte delantera de la cadera indica que el rango es demasiado profundo."
          }
        }
      }
    },
    "rehab_up_to_4_10_pain_during_the_hold_is_commonly_considered_acceptable_for_pa" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to ~4/10 pain during the hold is commonly considered acceptable for patellar tendon pain; it should settle back to baseline within 24 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta ~4/10 de dolor durante el mantenido suele considerarse aceptable en dolor de tendón rotuliano; debe volver al nivel basal en 24 horas."
          }
        }
      }
    },
    "rehab_use_the_other_leg_to_help_rise_back_up_then_repeat_do_one_set_with_the_k" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the other leg to help rise back up, then repeat. Do one set with the knee straight and, if prescribed, one with the knee slightly bent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la otra pierna para ayudarte a subir y repite. Haz una serie con la rodilla recta y, si se indica, otra con la rodilla ligeramente flexionada."
          }
        }
      }
    },
    "rehab_use_this_version_when_the_tendon_is_too_irritable_for_the_full_eccentric" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this version when the tendon is too irritable for the full eccentric drop below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa esta versión cuando el tendón está demasiado irritable para la bajada excéntrica completa."
          }
        }
      }
    },
    "rehab_using_only_your_foot_draw_each_letter_of_the_alphabet_in_the_air" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using only your foot, \"draw\" each letter of the alphabet in the air."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando solo el pie, \"dibuja\" en el aire cada letra del alfabeto."
          }
        }
      }
    },
    "rehab_with_your_other_hand_press_down_gently_on_the_back_of_your_hand" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your other hand, press down gently on the back of your hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la otra mano, presiona suavemente el dorso de la mano."
          }
        }
      }
    },
    "rehab_with_your_other_hand_press_down_gently_on_your_palm" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your other hand, press down gently on your palm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la otra mano, presiona suavemente la palma."
          }
        }
      }
    },
    "rehab_without_letting_the_elbow_drift_from_your_side_rotate_your_forearm_outwa" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without letting the elbow drift from your side, rotate your forearm outward against the band."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin dejar que el codo se separe del costado, rota el antebrazo hacia afuera contra la banda."
          }
        }
      }
    },
    "rehab_working_discomfort_up_to_about_4_10_during_the_hold_is_generally_accepta" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Working discomfort up to about 4/10 during the hold is generally acceptable for tendon pain. Ease off the pressure if it goes higher, and stop the session if pain doesn't drop back down within a few minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una molestia de trabajo de hasta unos 4/10 durante el mantenido suele ser aceptable en dolor tendinoso. Reduce la presión si sube más, y detén la sesión si el dolor no baja en pocos minutos."
          }
        }
      }
    },
